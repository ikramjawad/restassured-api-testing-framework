<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ecommerce.api</groupId>
    <artifactId>ecommerce-api-automation</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>ECommerce-API-Automation</name>
    <description>RestAssured API automation framework for an e-commerce deals/reservations API</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <rest-assured.version>5.4.0</rest-assured.version>
        <testng.version>7.9.0</testng.version>
        <jackson.version>2.17.1</jackson.version>
        <maven.surefire.version>3.2.5</maven.surefire.version>
        <dotenv.version>3.0.0</dotenv.version>

        <!-- Suite to run and where its reports go. The smoke profiles below override both. -->
        <suiteXmlFile>testng.xml</suiteXmlFile>
        <surefireReportsDirectory>${project.build.directory}/surefire-reports</surefireReportsDirectory>
        <!-- Time zone for smoke report folder names and the report's Start column. -->
        <reportTimeZone>Asia/Karachi</reportTimeZone>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>${dotenv.version}</version>
        </dependency>

        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
                    </suiteXmlFiles>
                    <reportsDirectory>${surefireReportsDirectory}</reportsDirectory>
                    <!-- TestNG's own HTML reports (index.html, testng-results.xml) are written to the
                         reports directory by default; Surefire has no useDefaultListeners parameter.
                         emailable-report.html comes from ReadableEmailableReporter (readable start
                         times), so TestNG's default emailable reporter is switched off. -->
                    <systemPropertyVariables>
                        <noEmailableReporter>true</noEmailableReporter>
                        <report.timezone>${reportTimeZone}</report.timezone>
                    </systemPropertyVariables>
                    <properties>
                        <property>
                            <name>listener</name>
                            <value>com.ecommerce.api.reporting.ReadableEmailableReporter</value>
                        </property>
                    </properties>
                </configuration>
            </plugin>

            <!-- Maven's own build timestamp is always UTC, so the smoke report folders get their
                 run timestamp (${runTimestamp}) from here instead, in reportTimeZone. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>run-timestamp</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>timestamp-property</goal>
                        </goals>
                        <configuration>
                            <name>runTimestamp</name>
                            <pattern>yyyyMMdd-HHmmss</pattern>
                            <timeZone>${reportTimeZone}</timeZone>
                            <locale>en_US</locale>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Smoke suites. Each run writes its own surefire report folder (XML + TestNG HTML) to
         target/surefire-reports/<suite>/<yyyyMMdd-HHmmss>-PKT/ so runs never overwrite each other. -->
    <profiles>
        <profile>
            <id>smoke-1</id>
            <properties>
                <suiteXmlFile>testng-smoke-1.xml</suiteXmlFile>
                <surefireReportsDirectory>${project.build.directory}/surefire-reports/smoke-1/${runTimestamp}-PKT</surefireReportsDirectory>
            </properties>
        </profile>
        <profile>
            <id>smoke-2</id>
            <properties>
                <suiteXmlFile>testng-smoke-2.xml</suiteXmlFile>
                <surefireReportsDirectory>${project.build.directory}/surefire-reports/smoke-2/${runTimestamp}-PKT</surefireReportsDirectory>
            </properties>
        </profile>
        <profile>
            <id>smoke-3</id>
            <properties>
                <suiteXmlFile>testng-smoke-3.xml</suiteXmlFile>
                <surefireReportsDirectory>${project.build.directory}/surefire-reports/smoke-3/${runTimestamp}-PKT</surefireReportsDirectory>
            </properties>
        </profile>
        <profile>
            <id>smoke</id>
            <properties>
                <suiteXmlFile>testng-smoke.xml</suiteXmlFile>
                <surefireReportsDirectory>${project.build.directory}/surefire-reports/smoke-all/${runTimestamp}-PKT</surefireReportsDirectory>
            </properties>
        </profile>
    </profiles>
</project>
