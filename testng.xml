    <test name="Deals API Tests">
        <classes>
            <class name="com.ecommerce.api.tests.deals.DealsTests"/>
            <class name="com.ecommerce.api.tests.deals.DealDetailTests"/>
        </classes>
    </test>

    <test name="Reservations API Tests">
        <classes>
            <class name="com.ecommerce.api.tests.reservations.ReservationsTests"/>
